# --- simulation flow
sprocess sprocess "" {}
sprocess Wb "0.008" {0.008} V
sprocess Wt "0.008" {0.008} V
sprocess Type "pMOS" {pMOS nMOS} R
sprocess DEVICEMESH "1" {1} R+
HCD sdevice "" {}
HCD Kf1 "0.76" {1e7 7.2e7} V
HCD Kf3 "5.75e0" {1.0e-2 1e4} V
HCD Vg_Stress "-1.0" {1.3 1.0 1.5 1.7} V
HCD Vd_Stress "-1.7" {1.3 1.7 1.0 1.5} V
HCD TfinalStress "1000" {1000} R
sdevice_IV sdevice "--tcl" {}
svisual svisual "" {}
