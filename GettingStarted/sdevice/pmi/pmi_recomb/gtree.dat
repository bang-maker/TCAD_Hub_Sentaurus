# --- simulation flow
sde sde "" {}
sdevice sdevice "" {}
sdevice Auger "builtin" {builtin pmi}
sdevice C "_" {_ 1e-20}
svisual svisual "" {}
# --- variables
# --- scenarios and parameter specs
scenario default Auger ""
scenario default C ""
# --- simulation tree
0 1 0 {} {default} 0
1 2 1 {} {default} 0
2 3 2 {builtin} {default} 0
3 5 3 {_} {default} 0
4 8 5 {} {default} 0
2 4 2 {pmi} {default} 0
3 6 4 {_} {default} 0
4 9 6 {} {default} 0
3 7 4 {1e-20} {default} 0
4 10 7 {} {default} 0
