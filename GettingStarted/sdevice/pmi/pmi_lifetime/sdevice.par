Scharfetter {
  * tau = taumin + ( taumax - taumin ) / ( 1 + ( N/Nref )^gamma
  * tau(T) = tau * ( (T/300)^Talpha )          (TempDep)
  * tau(T) = tau * exp( Tcoeff * ((T/300)-1) ) (ExpTempDep)
  taumin  = 0,       0       # [s]
  taumax  = 1.0e-5,  3.0e-6  # [s]
  Nref    = 1.0e16,  1.0e16  # [cm^(-3)]
  gamma   = 1,       1       # [1]
  Talpha  = -1.5,   -1.5     # [1]
  Tcoeff  = 2.55,    2.55    # [1]
  Etrap   = 0                # [eV]
}


pmi_lifetime {
  taumin_e = 0.0      # [s]
  taumin_h = 0.0      # [s]
  taumax_e = 1.0e-5   # [s]
  taumax_h = 3.0e-6   # [s]
  Nref_e   = 1.0e16   # [cm^(-3)]
  Nref_h   = 1.0e16   # [cm^(-3)]
  gamma_e  = 1.0      # [1]
  gamma_h  = 1.0      # [1]
  Talpha_e = -1.5     # [1]
  Talpha_h = -1.5     # [1]
}

pmi_lifetime_std {
  taumin_e = 0.0      # [s]
  taumin_h = 0.0      # [s]
  taumax_e = 1.0e-5   # [s]
  taumax_h = 3.0e-6   # [s]
  Nref_e   = 1.0e16   # [cm^(-3)]
  Nref_h   = 1.0e16   # [cm^(-3)]
  gamma_e  = 1.0      # [1]
  gamma_h  = 1.0      # [1]
  Talpha_e = -1.5     # [1]
  Talpha_h = -1.5     # [1]
}
