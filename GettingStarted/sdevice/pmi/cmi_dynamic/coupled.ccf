DEVICE coupled
  ELECTRODES
    u1           // input voltage, high
    u2           // input voltage, low
    u3           // output voltage, high
    u4           // output voltage, low
  INTERNALS
    i1           // input current
    i2           // output current
  STATES
    double m     // mutual inductance
  PARAMETERS
    double ind1  // primary inductance
    double ind2  // secondary inductance
    double k     // coupling factor
END DEVICE

PSET coupled_pset
  DEVICE coupled
  PARAMETERS
    k       = 1
END PSET

