# --- simulation flow
sprocess sprocess "" {}
sprocess Lg "0.25" {0.25}
sprocess NWell "1e+17" {5e+16 1e+17}
sprocess GOxTime "10" {10}
sprocess LDD_Dose "1e+14" {1e+14}
sdevice sdevice "" {}
sdevice VdLin "0.05" {0.05}
sdevice VdSat "2.5" {3.0}
sdevice pmi "builtin" {builtin pmi pmi_std}
IV svisual "" {}
# --- variables
# --- scenarios and parameter specs
scenario default Lg ""
scenario default NWell ""
scenario default GOxTime ""
scenario default LDD_Dose ""
scenario default VdLin ""
scenario default VdSat ""
scenario default pmi ""
