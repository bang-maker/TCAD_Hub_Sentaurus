   Material= "Oxide" {
	   BarrierTunneling  
	   { 
		   mt	= _mte_ ,	_mth_	# [1]
	   }
   }

   Material= "Silicon" {
	   BarrierTunneling  
	   { 
		   mt	= 0.19 ,	0.16	# [1]
	   }
   }

   Material= "PolySi" {
      BarrierTunneling  
      { 
	      mt	= 0.19 ,	0.16	# [1]
      }
   }

#endif


