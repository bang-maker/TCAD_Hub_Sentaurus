# --- simulation flow
sde sde "" {}
sde type "p" {p}
sim1 sdevice "" {}
sim1 trap_type "eneutral" {eneutral}
sim1 fill_control "frozen" {frozen empty full 0 n}
# --- variables
# --- scenarios and parameter specs
scenario default type ""
scenario default trap_type ""
scenario default fill_control ""
# --- simulation tree
0 1 0 {} {default} 0
1 2 1 {p} {default} 0
2 3 2 {} {default} 0
3 4 3 {eneutral} {default} 0
4 5 4 {frozen} {default} 0
4 6 4 {empty} {default} 0
4 7 4 {full} {default} 0
4 8 4 {0} {default} 0
4 9 4 {n} {default} 0
