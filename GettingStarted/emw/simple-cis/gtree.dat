# swbtree vT-2022.03-L1

# --- simulation flow
pixel sde "" {}
pixel geo "_" {_}
pixel t_sub "1" {1}
beol sde "" {}
beol MeStack "1" {1}
beol Lens "1" {1}
beol r_Lens "0.5" {0.4}
snmesh snmesh "" {}
snmesh wavelength "0.94" {0.6}
snmesh npw "5" {15}
snmesh npwz "_" {20}
snmesh fmax "2" {1.5}
emw emw "-hw @gpu@ --profile" {}
emw model "dispersive_plot" {plot_transSens}
emw tol "1e-2" {20}
emw Nrise "4" {4}
emw movieCuts "Ex_Gzpoly" {Ex}
emw movieTickStep "0" {100}
emw nthreads "8" {4}
emw gpu "none" {none}
svisual svisual "" {}
movie svisual "-ss" {}
# --- variables
# --- scenarios and parameter specs
scenario default geo ""
scenario default t_sub ""
scenario default MeStack ""
scenario default Lens ""
scenario default r_Lens ""
scenario default wavelength ""
scenario default npw ""
scenario default npwz ""
scenario default fmax ""
scenario default model ""
scenario default tol ""
scenario default Nrise ""
scenario default movieCuts ""
scenario default movieTickStep ""
scenario default nthreads ""
scenario default gpu ""
scenario integrVar geo ""
scenario integrVar t_sub ""
scenario integrVar MeStack ""
scenario integrVar Lens ""
scenario integrVar r_Lens ""
scenario integrVar wavelength ""
scenario integrVar npw ""
scenario integrVar npwz ""
scenario integrVar fmax ""
scenario integrVar model ""
scenario integrVar tol ""
scenario integrVar Nrise ""
scenario integrVar movieCuts ""
scenario integrVar movieTickStep ""
scenario integrVar nthreads ""
scenario integrVar gpu ""
