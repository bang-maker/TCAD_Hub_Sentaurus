##--mgoals settings
mgoals accuracy=1e-6
grid Adaptive set.min.normal.size= 0.005 \
     set.normal.growth.ratio.2d= 1.3

pdbSetBoolean Grid MGoals UseLines 1 
refinebox !keep.lines

pdbSet Grid Refine.Check             0

pdbSet Grid AdaptiveField Refine.Abs.Error     1e37
pdbSet Grid AdaptiveField Refine.Rel.Error     1e10
pdbSet Grid AdaptiveField Refine.Target.Length 0.002

pdbSet Diffuse Diffuse.Regrid.Steps -1 
pdbSet Diffuse  Growth.Regrid.Steps -1 

##--adaptive mesh box
refinebox name= GLOBAL adaptive Silicon\
refine.min.edge= "0.003 0.003" refine.max.edge= "10.0 10.0" \
abs.error=       "Boron=1e15 Arsenic=5e16 Phosphorus=1e15 Indium=5e16 Fluorine=5e16 Antimony=5e17 " \
rel.error=       "Boron=0.25 Arsenic=0.25 Phosphorus=0.25 Indium=0.25 Fluorine=0.25 Antimony=0.70" \
max.dose.error=  "Boron=5e10 Arsenic=5e10 Phosphorus=5e10 Indium=5e10 Fluorine=5e10 Antimony=5e10"

##--interface boxes
refinebox min.normal.size= 0.001<um> normal.growth.ratio= 1.4 \
interface.materials= {Silicon} name= "SI_INT"

refinebox min.normal.size= 0.002<um> normal.growth.ratio= 1.4 \
interface.materials= {PolySilicon} name= "PO_INT"