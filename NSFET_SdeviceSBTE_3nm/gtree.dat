# --- simulation flow
genStackedNanoslab sprocess "" {}
genStackedNanoslab Threads "maximum" {12}
genStackedNanoslab preNLregionName "Channel" {Channel}
genStackedNanoslab zSpacing "0.0005" {0.5e-3}
genStackedNanoslab nStack "1" {3}
genStackedNanoslab tox "0.0006" {0.0006}
genStackedNanoslab thfo2 "0.0015" {0.0015}
genStackedNanoslab Type "pMOS" {nMOS pMOS}
genStackedNanoslab sOri "100" {100}
genStackedNanoslab cDir "110" {110}
genStackedNanoslab H "0.035" {0.005}
genStackedNanoslab W "0.015" {0.015}
genStackedNanoslab L "0.010" {0.012}
SdeviceSBTE_init sdevice "" {}
SdeviceSBTE_init WF "4.600" {4.677 4.624}
SdeviceSBTE_init VGATE "0.8" {0.70 -0.70}
SdeviceSBTE_init VDRAIN "-0.05" {0.05 -0.05 0.70 -0.70}
SdeviceSBTE SdeviceQTX "" {}
SdeviceSBTE Lnl_sde "4.0e-3" {4.0e-3}
SdeviceSBTE Nsubbands "10" {10 42}
SdeviceSBTE ScattRange "6" {6 18}
SdeviceSBTE Scattering "Ballistic" {Ballistic PH PH+SR PH+SR+CO}
IV_Parameters svisual "" {}
